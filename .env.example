# Copy to .env (or just export these) before running.

# Without a key the agent still runs end to end on its deterministic engine.
# With one, question phrasing, answer evaluation, and the closing report are
# generated by the model.
ANTHROPIC_API_KEY=

# Model + budgets
INTERVIEW_MODEL=claude-opus-5
INTERVIEW_TURN_EFFORT=low          # low | medium | high | xhigh | max
INTERVIEW_REPORT_EFFORT=medium
INTERVIEW_TURN_MAX_TOKENS=2000
INTERVIEW_REPORT_MAX_TOKENS=4000

# Interview shape (the spec's floor is 8 questions across 4 curriculum days)
INTERVIEW_MIN_QUESTIONS=8
INTERVIEW_MAX_QUESTIONS=14
INTERVIEW_MIN_DAYS=4
INTERVIEW_MAX_FOLLOWUPS=2

# Session retention (long-term history is out of scope)
INTERVIEW_SESSION_TTL=21600
INTERVIEW_MAX_SESSIONS=500

# Set to 1 to force the deterministic engine even when a key is present.
INTERVIEW_FORCE_OFFLINE=
